diff --git a/LocalMonoMod/src/MonoMod.Core/Platforms/Systems/AndroidMemoryPatch.cs b/LocalMonoMod/src/MonoMod.Core/Platforms/Systems/AndroidMemoryPatch.cs
new file mode 100644
index 0000000..07c28eb
--- /dev/null
+++ b/LocalMonoMod/src/MonoMod.Core/Platforms/Systems/AndroidMemoryPatch.cs
@@ -0,0 +1,226 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Diagnostics.CodeAnalysis;
+using System.Runtime.ExceptionServices;
+
+namespace MonoMod.Core.Platforms.Systems
+{
+    // Android-only policy. Kept separate from syscalls so the exact packaged implementation
+    // can be tested with synthetic maps and injected protection/cache failures on the host.
+    internal static class AndroidMemoryPatch
+    {
+        private const int Read = 1, Write = 2, Execute = 4;
+
+        private readonly record struct Mapping(nuint Start, nuint End, int Protection, bool Shared,
+            nuint Offset, string Device, ulong Inode);
+
+        internal readonly record struct Region(nint Address, nint Length, int Protection);
+
+        private static nuint AddressMask => IntPtr.Size == 8 ? unchecked((nuint)0x00ff_ffff_ffff_ffffUL) : nuint.MaxValue;
+        private static nuint ForMaps(nint address) => (nuint)address & AddressMask;
+
+        private static nuint End(nuint start, int length)
+        {
+            if (start == 0 || length <= 0)
+                throw new ArgumentOutOfRangeException(nameof(length), "A memory range must have a nonzero start and positive length.");
+            var end = checked(start + (nuint)length);
+            if (end > AddressMask)
+                throw new OverflowException("Android memory range crosses the untagged address space.");
+            return end;
+        }
+
+        private static List<Mapping> Parse(string[] lines)
+        {
+            var result = new List<Mapping>();
+            foreach (var line in lines)
+            {
+                var fields = line.Split(' ', StringSplitOptions.RemoveEmptyEntries);
+                if (fields.Length < 5)
+                    continue;
+                var separator = fields[0].IndexOf('-', StringComparison.Ordinal);
+                if (separator <= 0 || fields[1].Length != 4
+                    || !nuint.TryParse(fields[0].AsSpan(0, separator), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var start)
+                    || !nuint.TryParse(fields[0].AsSpan(separator + 1), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var end)
+                    || start >= end
+                    || !nuint.TryParse(fields[2], NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var offset)
+                    || !ulong.TryParse(fields[4], NumberStyles.None, CultureInfo.InvariantCulture, out var inode))
+                    continue;
+                var permissions = fields[1];
+                var protection = (permissions[0] == 'r' ? Read : 0)
+                    | (permissions[1] == 'w' ? Write : 0) | (permissions[2] == 'x' ? Execute : 0);
+                if (result.Count > 0 && start < result[result.Count - 1].End)
+                    throw new InvalidOperationException("Android memory mappings overlap or are unordered.");
+                result.Add(new(start, end, protection, permissions[3] == 's', offset, fields[3], inode));
+            }
+            return result;
+        }
+
+        private static List<Mapping> RequireRange(List<Mapping> mappings, nuint start, nuint end, int required)
+        {
+            var result = new List<Mapping>();
+            var cursor = start;
+            foreach (var mapping in mappings)
+            {
+                if (mapping.End <= cursor)
+                    continue;
+                if (mapping.Start > cursor || (mapping.Protection & required) != required)
+                    break;
+                result.Add(mapping);
+                cursor = mapping.End < end ? mapping.End : end;
+                if (cursor == end)
+                    return result;
+            }
+            throw new InvalidOperationException($"Android memory range 0x{start:x}-0x{end:x} is unmapped or lacks permissions {required}.");
+        }
+
+        internal static void RequireExecutable(string[] lines, nint address, int length)
+        {
+            var start = ForMaps(address);
+            _ = RequireRange(Parse(lines), start, End(start, length), Read | Execute);
+        }
+
+        internal static Region[] Plan(string[] lines, nint executableAddress, nint writeAddress,
+            int length, bool executable, nint pageSize)
+        {
+            var start = ForMaps(writeAddress);
+            var end = End(start, length);
+            var page = (nuint)pageSize;
+            if (pageSize <= 0 || (page & (page - 1)) != 0)
+                throw new ArgumentOutOfRangeException(nameof(pageSize));
+            var mappings = Parse(lines);
+            var writes = RequireRange(mappings, start, end, Read);
+            if (executable)
+            {
+                var codeStart = ForMaps(executableAddress);
+                var code = RequireRange(mappings, codeStart, End(codeStart, length), Read | Execute);
+                if (codeStart != start)
+                {
+                    // Only accept provable aliases of the same shared file bytes. Anonymous
+                    // or private mappings cannot establish alias identity from /proc/self/maps.
+                    var offset = (nuint)0;
+                    var codeIndex = 0;
+                    var writeIndex = 0;
+                    while (offset < (nuint)length)
+                    {
+                        var rx = code[codeIndex];
+                        var rw = writes[writeIndex];
+                        var rxCursor = checked(codeStart + offset);
+                        var rwCursor = checked(start + offset);
+                        if (!rx.Shared || !rw.Shared || rx.Inode == 0 || rx.Inode != rw.Inode
+                            || rx.Device != rw.Device || (rw.Protection & Write) == 0
+                            || checked(rx.Offset + rxCursor - rx.Start) != checked(rw.Offset + rwCursor - rw.Start))
+                            throw new InvalidOperationException("Android executable write alias could not be verified.");
+                        var chunk = Math.Min(rx.End - rxCursor, rw.End - rwCursor);
+                        offset = checked(offset + Math.Min(chunk, (nuint)length - offset));
+                        if (codeStart + offset == rx.End) codeIndex++;
+                        if (start + offset == rw.End) writeIndex++;
+                    }
+                }
+            }
+
+            var alignedStart = start & ~(page - 1);
+            var alignedEnd = checked(end + page - 1) & ~(page - 1);
+            var regions = new List<Region>();
+            foreach (var mapping in RequireRange(mappings, alignedStart, alignedEnd, Read))
+            {
+                if ((mapping.Start & (page - 1)) != 0 || (mapping.End & (page - 1)) != 0)
+                    throw new InvalidOperationException("Android mapping is not page aligned.");
+                var regionStart = Math.Max(alignedStart, mapping.Start);
+                var regionEnd = Math.Min(alignedEnd, mapping.End);
+                regions.Add(new((nint)regionStart, checked((nint)(regionEnd - regionStart)), mapping.Protection));
+            }
+            return regions.ToArray();
+        }
+
+        internal static unsafe void Apply(bool executable, nint executableAddress, nint writeAddress,
+            ReadOnlySpan<byte> data, Span<byte> backup, nint pageSize, string[] maps,
+            Action<nint, nint, int> protect, Action<nint, nint> flush, Action<string, Exception> failFast)
+        {
+            if (data.IsEmpty)
+                return;
+            if (!backup.IsEmpty && backup.Length < data.Length)
+                throw new ArgumentException("The backup cannot hold the complete patch.", nameof(backup));
+            var regions = Plan(maps, executableAddress, writeAddress, data.Length, executable, pageSize);
+            // Normalize only mapping/syscall addresses. Preserve the original logical tag for
+            // actual data access so ARM64 tagged memory does not become an untagged pointer.
+            var target = new Span<byte>((void*)writeAddress, data.Length);
+            // Always retain our own backup, including for Undo/ChangeTarget callers that pass none.
+            var original = target.ToArray();
+            var replacement = data.ToArray();
+            if (!backup.IsEmpty)
+                original.AsSpan().CopyTo(backup);
+            var attemptedProtection = new bool[regions.Length];
+            var wrote = false;
+            try
+            {
+                for (var i = 0; i < regions.Length; i++)
+                {
+                    var region = regions[i];
+                    if ((region.Protection & Write) == 0)
+                    {
+                        // Mark before the syscall: a failed mprotect can have changed some pages.
+                        attemptedProtection[i] = true;
+                        protect(region.Address, region.Length, region.Protection | Write);
+                    }
+                }
+                wrote = true;
+                replacement.AsSpan().CopyTo(target);
+                Flush(executable, executableAddress, writeAddress, data.Length, flush);
+                Restore(regions, attemptedProtection, protect);
+            }
+            catch (Exception failure)
+            {
+                try
+                {
+                    if (wrote)
+                    {
+                        for (var i = 0; i < regions.Length; i++)
+                        {
+                            if (attemptedProtection[i])
+                            {
+                                var region = regions[i];
+                                protect(region.Address, region.Length, region.Protection | Write);
+                            }
+                        }
+                        original.AsSpan().CopyTo(target);
+                        Flush(executable, executableAddress, writeAddress, data.Length, flush);
+                        if (!target.SequenceEqual(original))
+                            throw new InvalidOperationException("Android patch rollback bytes differ from the original.");
+                    }
+                    Restore(regions, attemptedProtection, protect);
+                }
+                catch (Exception rollbackFailure)
+                {
+                    failFast("Android detour rollback failed; continuing could execute damaged code.",
+                        new AggregateException(failure, rollbackFailure));
+                    throw new InvalidOperationException("The fatal Android rollback handler returned.");
+                }
+                throw;
+            }
+        }
+
+        [SuppressMessage("Design", "CA1031:Do not catch general exception types",
+            Justification = "Every mapping must be restored before propagating the first failure with its original stack.")]
+        private static void Restore(Region[] regions, bool[] attempted, Action<nint, nint, int> protect)
+        {
+            // Attempt every restoration even if an earlier region fails.
+            Exception? failure = null;
+            for (var i = regions.Length - 1; i >= 0; i--)
+            {
+                if (!attempted[i]) continue;
+                var region = regions[i];
+                try { protect(region.Address, region.Length, region.Protection); }
+                catch (Exception error) { failure ??= error; }
+            }
+            if (failure is not null) ExceptionDispatchInfo.Capture(failure).Throw();
+        }
+
+        private static void Flush(bool executable, nint code, nint write, int length, Action<nint, nint> flush)
+        {
+            if (!executable) return;
+            flush(write, length);
+            if (code != write) flush(code, length);
+        }
+    }
+}
