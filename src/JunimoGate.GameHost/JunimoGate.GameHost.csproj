<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android35.0</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <JunimoGateRequiresSmapi>true</JunimoGateRequiresSmapi>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2-junimogate.11" />
    <PackageReference Include="MonoGame.Framework.Android" Version="1.0.0-junimogate.f5d8bf.4" />
    <ProjectReference Include="../JunimoGate.Core/JunimoGate.Core.csproj" />
    <ProjectReference Include="../JunimoGate.Android/JunimoGate.Android.csproj" />
    <ProjectReference Include="../JunimoGate.Extraction/JunimoGate.Extraction.csproj" />
    <ProjectReference Include="../JunimoGate.Mods/JunimoGate.Mods.csproj" />
    <ProjectReference Include="../JunimoGate.Rewriter/JunimoGate.Rewriter.csproj" />
    <ProjectReference Include="../../smapi/src/SMAPI/SMAPI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="../../smapi/src/SMAPI/SMAPI.config.json">
      <Link>smapi-internal/config.json</Link>
    </AndroidAsset>
    <AndroidAsset Include="../../smapi/resources/metadata.json">
      <Link>smapi-internal/metadata.json</Link>
    </AndroidAsset>
    <AndroidAsset Include="../../smapi/resources/blacklist.json">
      <Link>smapi-internal/blacklist.json</Link>
    </AndroidAsset>
    <AndroidAsset Include="../../smapi/src/SMAPI/i18n/*.json">
      <Link>smapi-internal/i18n/%(Filename)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="../../artifacts/native-cacheflush/libjunimogate-cacheflush.so">
      <Link>lib/arm64-v8a/libjunimogate-cacheflush.so</Link>
    </AndroidNativeLibrary>
  </ItemGroup>
</Project>
