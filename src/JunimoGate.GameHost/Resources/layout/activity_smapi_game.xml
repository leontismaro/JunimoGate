<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <FrameLayout
        android:id="@+id/smapi_game_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/smapi_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/smapi_loading_image_frame"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/junimogate_game_loading" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/smapi_game_loading"
            android:textColor="#202124"
            android:textSize="22sp" />
    </LinearLayout>
</FrameLayout>
