<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingTop="48dp">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/mods_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:liftOnScroll="true">

        <LinearLayout
            android:id="@+id/mods_search_tools"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_scrollFlags="scroll|enterAlways">

        <SearchView
            android:id="@+id/mods_search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
            android:background="@drawable/junimo_search_background"
            android:iconifiedByDefault="false"
                android:queryHint="@string/mods_search_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mods_import"
            style="@style/JunimoGate.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/mods_import_action"
                android:minWidth="0dp"
                android:text="@string/mods_import_button"
                android:tooltipText="@string/mods_import_action"
                app:icon="@drawable/ic_download_24"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mods_batch"
                style="@style/JunimoGate.IconButton"
                android:contentDescription="@string/mods_batch"
                android:tooltipText="@string/mods_batch"
                app:icon="@drawable/ic_checklist_24" />
        </LinearLayout>

        <TextView
            android:id="@+id/mods_inventory_count"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_scrollFlags="scroll|enterAlways" />

        <TextView
            android:id="@+id/mods_import_progress_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="2"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/mods_batch_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mods_batch_done"
                style="@style/JunimoGate.IconButton"
                android:contentDescription="@string/action_done"
                android:tooltipText="@string/action_done"
                app:icon="@drawable/ic_close_24" />

            <TextView
                android:id="@+id/mods_selected_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mods_select_all"
                style="@style/JunimoGate.IconButton"
                android:contentDescription="@string/mods_select_all"
                android:tooltipText="@string/mods_select_all"
                app:icon="@drawable/ic_select_all_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mods_add_selected"
                style="@style/JunimoGate.IconButton"
                android:contentDescription="@string/mods_add_to_group"
                android:tooltipText="@string/mods_add_to_group"
                app:icon="@drawable/ic_add_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mods_delete_selected"
                style="@style/JunimoGate.IconButton"
                android:contentDescription="@string/mods_delete_selected"
                android:tooltipText="@string/mods_delete_selected"
                app:icon="@drawable/ic_delete_24" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/mods_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_anchor="@id/mods_app_bar"
        app:layout_anchorGravity="bottom" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:id="@+id/mods_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/mods_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mods_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="16dp" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
