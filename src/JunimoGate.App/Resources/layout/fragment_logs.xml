<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/logs_source_group"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            app:checkedButton="@id/logs_source_launcher"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_source_launcher"
                style="@style/JunimoGate.Button.LogSegment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/logs_source_launcher" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_source_game"
                style="@style/JunimoGate.Button.LogSegment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/logs_source_game" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_source_smapi"
                style="@style/JunimoGate.Button.LogSegment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/logs_source_smapi_short" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/logs_generation_group"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            app:checkedButton="@id/logs_current"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_crash"
                style="@style/JunimoGate.Button.LogSegment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/logs_crash"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_current"
                style="@style/JunimoGate.Button.LogSegment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/logs_current" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_previous"
                style="@style/JunimoGate.Button.LogSegment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/logs_previous" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/logs_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/logs_file_unavailable"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logs_refresh"
            style="@style/JunimoGate.IconButton"
            android:contentDescription="@string/logs_refresh"
            android:tooltipText="@string/logs_refresh"
            app:icon="@drawable/ic_refresh_24" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/logs_filter_group"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            app:checkedButton="@id/logs_filter_important"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_filter_important"
                style="@style/JunimoGate.Button.LogSegment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/logs_filter_important" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_filter_all"
                style="@style/JunimoGate.Button.LogSegment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/logs_filter_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_filter_errors"
                style="@style/JunimoGate.Button.LogSegment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/logs_filter_errors" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_filter_warnings"
                style="@style/JunimoGate.Button.LogSegment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/logs_filter_warnings" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logs_search_toggle"
            style="@style/JunimoGate.IconButton"
            android:contentDescription="@string/logs_search_hint"
            android:tooltipText="@string/logs_search_hint"
            app:icon="@drawable/ic_search_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logs_more"
            style="@style/JunimoGate.IconButton"
            android:contentDescription="@string/logs_more_actions"
            android:tooltipText="@string/logs_more_actions"
            app:icon="@drawable/ic_more_vert_24" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/logs_search_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <SearchView
            android:id="@+id/logs_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:iconifiedByDefault="false"
            android:queryHint="@string/logs_search_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logs_search_close"
            style="@style/JunimoGate.IconButton"
            android:contentDescription="@string/logs_search_close"
            android:tooltipText="@string/logs_search_close"
            app:icon="@drawable/ic_close_24" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/junimo_log_surface">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logs_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <ScrollView
            android:id="@+id/logs_raw_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/logs_raw_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>

        <TextView
            android:id="@+id/logs_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/logs_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </FrameLayout>
</LinearLayout>
