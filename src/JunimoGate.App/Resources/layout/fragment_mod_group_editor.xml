<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp">

    <EditText
        android:id="@+id/mod_group_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/mod_groups_name_hint"
        android:inputType="textCapSentences"
        android:maxLength="80"
        android:singleLine="true" />

    <EditText
        android:id="@+id/mod_group_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/mod_group_description_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="1024"
        android:maxLines="3" />

    <Spinner
        android:id="@+id/mod_group_policy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <SearchView
        android:id="@+id/mod_group_member_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:iconifiedByDefault="false"
        android:queryHint="@string/mod_group_member_search_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mod_group_select_all"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mod_group_select_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mod_group_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mod_group_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mod_group_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mod_group_save" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/mod_group_editor_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mod_group_members"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
