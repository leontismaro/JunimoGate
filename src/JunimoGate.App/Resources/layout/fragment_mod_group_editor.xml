<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:id="@+id/mod_group_editor_toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SearchView
            android:id="@+id/mod_group_member_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/junimo_search_background"
            android:iconifiedByDefault="false"
            android:queryHint="@string/mod_group_member_search_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mod_group_info"
            style="@style/JunimoGate.IconButton"
            android:contentDescription="@string/mod_group_info"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:padding="12dp"
            android:text=""
            android:tooltipText="@string/mod_group_info"
            app:icon="@drawable/ic_settings_24"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mod_group_add"
            style="@style/JunimoGate.IconButton.Tonal"
            android:contentDescription="@string/mod_group_add_from_library"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:padding="12dp"
            android:text=""
            android:tooltipText="@string/mod_group_add_from_library"
            app:icon="@drawable/ic_add_24"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mod_group_batch"
            style="@style/JunimoGate.IconButton"
            android:contentDescription="@string/mod_group_batch"
            android:tooltipText="@string/mod_group_batch"
            app:icon="@drawable/ic_checklist_24" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mod_group_batch_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mod_group_batch_done"
                style="@style/JunimoGate.IconButton"
                android:contentDescription="@string/action_done"
                android:tooltipText="@string/action_done"
                app:icon="@drawable/ic_close_24" />

            <TextView
                android:id="@+id/mod_group_selected_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mod_group_select_all"
                style="@style/JunimoGate.IconButton"
                android:contentDescription="@string/mod_group_select_all"
                android:tooltipText="@string/mod_group_select_all"
                app:icon="@drawable/ic_select_all_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mod_group_enable_selected"
                style="@style/JunimoGate.IconButton"
                android:contentDescription="@string/mod_group_enable_selected"
                android:tooltipText="@string/mod_group_enable_selected"
                app:icon="@drawable/ic_toggle_on_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mod_group_disable_selected"
                style="@style/JunimoGate.IconButton"
                android:contentDescription="@string/mod_group_disable_selected"
                android:tooltipText="@string/mod_group_disable_selected"
                app:icon="@drawable/ic_toggle_off_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mod_group_remove_selected"
                style="@style/JunimoGate.IconButton"
                android:contentDescription="@string/mod_group_remove_selected"
                android:tooltipText="@string/mod_group_remove_selected"
                app:icon="@drawable/ic_delete_24" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/mod_group_editor_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mod_group_editor_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/mod_group_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/mod_group_members_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mod_group_empty_add"
            style="@style/JunimoGate.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/mod_group_add_from_library"
            app:icon="@drawable/ic_add_24" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mod_group_members"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
