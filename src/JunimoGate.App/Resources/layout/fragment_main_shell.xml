<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false">

    <FrameLayout
        android:id="@+id/home_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/junimogate_home_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/junimo_home_background_scrim" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/top_app_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:title="@string/app_name"
            app:elevation="0dp"
            app:titleCentered="false" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/shell_nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/main_navigation" />

        <FrameLayout
            android:id="@+id/bottom_navigation_container"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bottom_navigation"
                style="@style/JunimoGate.Card.Navigation"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/bottom_navigation_home"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bottom_nav_touch_background"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/bottom_navigation_home_indicator"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/bottom_nav_item_background" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:duplicateParentState="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:duplicateParentState="true"
                                app:srcCompat="@drawable/ic_home_24" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:duplicateParentState="true"
                                android:text="@string/nav_home"
                                android:textAppearance="?attr/textAppearanceLabelMedium" />
                        </LinearLayout>
                    </FrameLayout>

                    <Space
                        android:layout_width="72dp"
                        android:layout_height="match_parent" />

                    <FrameLayout
                        android:id="@+id/bottom_navigation_mods"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bottom_nav_touch_background"
                        android:clickable="true"
                        android:focusable="true">
                        <View
                            android:id="@+id/bottom_navigation_mods_indicator"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/bottom_nav_item_background" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:duplicateParentState="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:duplicateParentState="true"
                                app:srcCompat="@drawable/ic_extension_24" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:duplicateParentState="true"
                                android:text="@string/nav_mods"
                                android:textAppearance="?attr/textAppearanceLabelMedium" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/launch_action"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/launch_game"
                android:enabled="false"
                app:elevation="12dp"
                app:fabCustomSize="68dp"
                app:maxImageSize="62dp"
                app:srcCompat="@drawable/junimogate_launch_icon"
                app:tint="@null" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/launch_progress"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone"
                app:indicatorSize="64dp"
                app:trackThickness="3dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
