<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/JunimoGate.Card.List"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/mod_item_selected"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mod_item_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/mod_item_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>

            <ImageView
                android:id="@+id/mod_item_expand"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/mods_expand_item"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_expand_more_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mod_item_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/mod_item_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:id="@+id/mod_item_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <LinearLayout
                android:id="@+id/mod_item_components"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mod_item_add"
                    style="@style/JunimoGate.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/mods_add_to_group"
                    app:icon="@drawable/ic_add_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mod_item_details"
                    style="@style/JunimoGate.IconButton"
                    android:contentDescription="@string/mods_details_action"
                    android:tooltipText="@string/mods_details_action"
                    app:icon="@drawable/ic_info_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mod_item_export"
                    style="@style/JunimoGate.IconButton"
                    android:contentDescription="@string/mods_bundle_export"
                    android:tooltipText="@string/mods_bundle_export"
                    android:visibility="gone"
                    app:icon="@drawable/ic_share_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mod_item_restore"
                    style="@style/JunimoGate.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/mods_bundle_restore"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mod_item_delete"
                    style="@style/JunimoGate.IconButton"
                    android:contentDescription="@string/mods_delete_action"
                    android:tooltipText="@string/mods_delete_action"
                    app:icon="@drawable/ic_delete_24" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
