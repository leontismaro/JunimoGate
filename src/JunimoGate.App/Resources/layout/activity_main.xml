<?xml version="1.0" encoding="utf-8"?>
<org.junimogate.app.InteractiveDrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false">

    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="false">

        <FrameLayout
            android:id="@+id/home_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/junimogate_home_background" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/junimo_home_background_scrim" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/top_app_bar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                android:title="@string/app_name"
                app:elevation="0dp"
                app:titleCentered="false" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_host_fragment"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:defaultNavHost="true"
                app:navGraph="@navigation/main_navigation" />

            <FrameLayout
                android:id="@+id/bottom_navigation_container"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bottom_navigation"
                    style="@style/JunimoGate.Card.Navigation"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="8dp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/bottom_navigation_home"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bottom_nav_touch_background"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:id="@+id/bottom_navigation_home_indicator"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:background="@drawable/bottom_nav_item_background" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:duplicateParentState="true"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:contentDescription="@null"
                                    android:duplicateParentState="true"
                                    app:srcCompat="@drawable/ic_home_24" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:duplicateParentState="true"
                                    android:text="@string/nav_home"
                                    android:textAppearance="?attr/textAppearanceLabelMedium" />
                            </LinearLayout>
                        </FrameLayout>

                        <Space
                            android:layout_width="72dp"
                            android:layout_height="match_parent" />

                        <FrameLayout
                            android:id="@+id/bottom_navigation_mods"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bottom_nav_touch_background"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:id="@+id/bottom_navigation_mods_indicator"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:background="@drawable/bottom_nav_item_background" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:duplicateParentState="true"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:contentDescription="@null"
                                    android:duplicateParentState="true"
                                    app:srcCompat="@drawable/ic_extension_24" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:duplicateParentState="true"
                                    android:text="@string/nav_mods"
                                    android:textAppearance="?attr/textAppearanceLabelMedium" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/launch_action"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="@string/launch_game"
                    android:enabled="false"
                    app:elevation="12dp"
                    app:fabCustomSize="68dp"
                    app:hoveredFocusedTranslationZ="2dp"
                    app:maxImageSize="62dp"
                    app:pressedTranslationZ="4dp"
                    app:srcCompat="@drawable/junimogate_launch_icon"
                    app:tint="@null" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/launch_progress"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone"
                    app:indicatorSize="64dp"
                    app:trackThickness="3dp" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/drawer_open"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="120dp"
            android:contentDescription="@string/drawer_open"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:elevation="6dp"
            app:fabCustomSize="48dp"
            app:maxImageSize="24dp"
            app:srcCompat="@drawable/ic_menu_24" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/drawer_content"
        android:layout_width="@dimen/junimo_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="false"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/drawer_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:menu="@menu/drawer_navigation" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/drawer_close"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/drawer_close"
            android:padding="16dp"
            app:srcCompat="@drawable/ic_chevron_left_24" />
    </LinearLayout>

</org.junimogate.app.InteractiveDrawerLayout>
