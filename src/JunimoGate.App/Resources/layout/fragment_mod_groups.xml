<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="56dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mod_groups_import"
            style="@style/JunimoGate.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/mod_groups_import_action"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/mod_groups_import_action"
            android:tooltipText="@string/mod_groups_import_action"
            app:icon="@drawable/ic_download_24"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mod_groups_create"
            style="@style/JunimoGate.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/mod_groups_create_action"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/mod_groups_create_action"
            android:tooltipText="@string/mod_groups_create_action"
            app:icon="@drawable/ic_add_24"
            app:iconPadding="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/mod_groups_progress_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/mod_groups_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mod_groups_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/mod_groups_empty"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mod_groups_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
