<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/JunimoGate.Card.List"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="76dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/mod_group_active"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:buttonTint="?attr/colorPrimary"
            android:contentDescription="@string/mod_groups_make_active"
            android:gravity="center"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/mod_group_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintEnd_toStartOf="@id/mod_group_actions"
            app:layout_constraintStart_toEndOf="@id/mod_group_active"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/mod_group_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            app:layout_constraintEnd_toStartOf="@id/mod_group_actions"
            app:layout_constraintStart_toEndOf="@id/mod_group_active"
            app:layout_constraintTop_toBottomOf="@id/mod_group_title" />

        <LinearLayout
            android:id="@+id/mod_group_actions"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mod_group_open"
                style="@style/JunimoGate.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/mod_groups_open"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:text=""
                android:tooltipText="@string/mod_groups_open"
                app:icon="@drawable/ic_edit_24"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mod_group_share"
                style="@style/JunimoGate.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/mod_groups_share"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:text=""
                android:tooltipText="@string/mod_groups_share"
                app:icon="@drawable/ic_share_24"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mod_group_delete"
                style="@style/JunimoGate.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/mods_delete_action"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:text=""
                android:tooltipText="@string/mods_delete_action"
                app:icon="@drawable/ic_delete_24"
                app:iconPadding="0dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
