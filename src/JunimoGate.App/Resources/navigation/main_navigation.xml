<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_navigation"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="org.junimogate.app.MainPagerFragment"
        android:label="@string/nav_home">
        <argument
            android:name="initialPage"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/navigation_mods"
        android:name="org.junimogate.app.MainPagerFragment"
        android:label="@string/nav_mods">
        <argument
            android:name="initialPage"
            android:defaultValue="1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/navigation_logs"
        android:name="org.junimogate.app.LogsFragment"
        android:label="@string/nav_logs" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="org.junimogate.app.SettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/navigation_environment"
        android:name="org.junimogate.app.EnvironmentFragment"
        android:label="@string/environment_title" />

    <fragment
        android:id="@+id/navigation_save_backups"
        android:name="org.junimogate.app.SaveBackupsFragment"
        android:label="@string/save_backups_title" />

    <fragment
        android:id="@+id/navigation_about"
        android:name="org.junimogate.app.AboutFragment"
        android:label="@string/about_title" />

    <fragment
        android:id="@+id/navigation_mod_group_editor"
        android:name="org.junimogate.app.ModGroupEditorFragment"
        android:label="@string/mod_group_editor_title" />
</navigation>
