<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android35.0</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.junimogate.app</ApplicationId>
    <ApplicationTitle>JunimoGate</ApplicationTitle>
    <ApplicationVersion>9</ApplicationVersion>
    <ApplicationDisplayVersion>0.3.1-beta.2</ApplicationDisplayVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <SelfContained>true</SelfContained>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <UseInterpreter>false</UseInterpreter>
    <AndroidUseInterpreter>false</AndroidUseInterpreter>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
    <AndroidEnableAssemblyCompression>false</AndroidEnableAssemblyCompression>
    <JunimoGateRequiresSmapi>true</JunimoGateRequiresSmapi>
    <!-- Dynamically loaded game assemblies reference framework/Android APIs invisible to the trimmer. -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <AndroidAsset Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" />
    <AndroidAsset Include="../../LICENSE" Link="licenses/JunimoGate-GPL-3.0-only.txt" />
    <AndroidAsset Include="../../LICENSE-EXCEPTION" Link="licenses/JunimoGate-MonoGame-Linking-Exception.txt" />
    <AndroidAsset Include="../../smapi/LICENSE.txt" Link="licenses/JunimoGate-SMAPI-LGPL-3.0-only.txt" />
    <AndroidAsset Include="../../licenses/Markdig-BSD-2-Clause.txt" Link="licenses/Markdig-BSD-2-Clause.txt" />
    <AndroidAsset Include="../../licenses/MonoGame-f5d8bf.txt" Link="licenses/MonoGame-f5d8bf.txt" />
    <AndroidAsset Include="../../licenses/OpenAL-Soft-1.24.3-COPYING.txt" Link="licenses/OpenAL-Soft-1.24.3-COPYING.txt" />
    <AndroidAsset Include="../../licenses/OpenAL-Soft-1.24.3-BSD-3-Clause.txt" Link="licenses/OpenAL-Soft-1.24.3-BSD-3-Clause.txt" />
    <AndroidAsset Include="../../licenses/StbSharp-PUBLIC-DOMAIN.txt" Link="licenses/StbSharp-PUBLIC-DOMAIN.txt" />
    <AndroidAsset Include="$(DOTNET_ROOT)/packs/Microsoft.NETCore.App.Runtime.Mono.android-arm64/9.0.17/LICENSE.TXT" Link="licenses/DotNet-Runtime-MIT.txt" />
    <AndroidAsset Include="$(DOTNET_ROOT)/packs/Microsoft.NETCore.App.Runtime.Mono.android-arm64/9.0.17/THIRD-PARTY-NOTICES.TXT" Link="licenses/DotNet-Runtime-THIRD-PARTY-NOTICES.txt" />
    <AndroidAsset Include="$(PkgSkiaSharp)/LICENSE.txt" Link="licenses/SkiaSharp-MIT.txt" />
    <AndroidAsset Include="$(NuGetPackageRoot)/skiasharp.nativeassets.android/4.150.1/THIRD-PARTY-NOTICES.txt" Link="licenses/SkiaSharp-THIRD-PARTY-NOTICES.txt" />
    <AndroidAsset Include="$(NuGetPackageRoot)/xamarin.androidx.appcompat/1.7.1.4/LICENSE.md" Link="licenses/AndroidX-Bindings-MIT.txt" />
    <AndroidAsset Include="$(NuGetPackageRoot)/xamarin.androidx.appcompat/1.7.1.4/THIRD-PARTY-NOTICES.txt" Link="licenses/AndroidX-Apache-2.0.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DeepCloner" Version="0.10.4" GeneratePathProperty="true" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.1" GeneratePathProperty="true" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2-junimogate.63" GeneratePathProperty="true" />
    <PackageReference Include="Markdig" Version="0.41.1" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" GeneratePathProperty="true" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" GeneratePathProperty="true" />
    <PackageReference Include="NVorbis" Version="0.10.5" GeneratePathProperty="true" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" GeneratePathProperty="true" />
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.2" GeneratePathProperty="true" />
    <PackageReference Include="Pintail" Version="2.8.1" GeneratePathProperty="true" />
    <PackageReference Include="Platonymous.TMXTile" Version="1.5.9" GeneratePathProperty="true" NoWarn="NU1701" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" GeneratePathProperty="true" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" GeneratePathProperty="true" />
    <PackageReference Include="TextCopy" Version="6.2.1" GeneratePathProperty="true" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.4" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.9.3" />
    <PackageReference Include="Xamarin.AndroidX.Navigation.Fragment" Version="2.9.8.1" />
    <PackageReference Include="Xamarin.AndroidX.Navigation.UI" Version="2.9.8.1" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.6" />
    <PackageReference Include="Xamarin.AndroidX.ViewPager2" Version="1.1.0.11" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
    <ProjectReference Include="../JunimoGate.Android/JunimoGate.Android.csproj" />
    <ProjectReference Include="../JunimoGate.Mods/JunimoGate.Mods.csproj" />
    <ProjectReference Include="../JunimoGate.GameHost/JunimoGate.GameHost.csproj" />
    <TrimmerRootDescriptor Include="linker.xml"
                           Condition="'$(Configuration)' == 'Release' and '$(PublishTrimmed)' == 'true'" />
  </ItemGroup>
  <Target Name="AddSmapiCommercialLinkReferences" BeforeTargets="_LinkAssembliesNoShrinkInputs">
    <ItemGroup>
      <ResolvedAssemblies Include="$(JunimoGateGameReferenceDir)/StardewValley.dll" AndroidSkipAddToPackage="true" Abi="arm64-v8a" DestinationSubPath="StardewValley.dll" />
      <ResolvedAssemblies Include="$(JunimoGateGameReferenceDir)/StardewValley.GameData.dll" AndroidSkipAddToPackage="true" Abi="arm64-v8a" DestinationSubPath="StardewValley.GameData.dll" />
      <ResolvedAssemblies Include="$(JunimoGateGameReferenceDir)/BmFont.dll" AndroidSkipAddToPackage="true" Abi="arm64-v8a" DestinationSubPath="BmFont.dll" />
      <ResolvedAssemblies Include="$(JunimoGateGameReferenceDir)/Lidgren.Network.dll" AndroidSkipAddToPackage="true" Abi="arm64-v8a" DestinationSubPath="Lidgren.Network.dll" />
      <ResolvedAssemblies Include="$(JunimoGateGameReferenceDir)/xTile.dll" AndroidSkipAddToPackage="true" Abi="arm64-v8a" DestinationSubPath="xTile.dll" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveSmapiCommercialPackageItems" AfterTargets="_LinkAssembliesNoShrink">
    <ItemGroup>
      <ResolvedAssemblies Remove="$(JunimoGateGameReferenceDir)/StardewValley.dll;$(JunimoGateGameReferenceDir)/StardewValley.GameData.dll;$(JunimoGateGameReferenceDir)/BmFont.dll;$(JunimoGateGameReferenceDir)/Lidgren.Network.dll;$(JunimoGateGameReferenceDir)/xTile.dll" />
      <_ResolvedAssemblies Remove="$(MonoAndroidIntermediateAssemblyDir)StardewValley.dll;$(MonoAndroidIntermediateAssemblyDir)StardewValley.GameData.dll;$(MonoAndroidIntermediateAssemblyDir)BmFont.dll;$(MonoAndroidIntermediateAssemblyDir)Lidgren.Network.dll;$(MonoAndroidIntermediateAssemblyDir)xTile.dll" />
      <_ResolvedUserAssemblies Remove="$(MonoAndroidIntermediateAssemblyDir)StardewValley.dll;$(MonoAndroidIntermediateAssemblyDir)StardewValley.GameData.dll;$(MonoAndroidIntermediateAssemblyDir)BmFont.dll;$(MonoAndroidIntermediateAssemblyDir)Lidgren.Network.dll;$(MonoAndroidIntermediateAssemblyDir)xTile.dll" />
      <_ResolvedUserMonoAndroidAssemblies Remove="$(MonoAndroidIntermediateAssemblyDir)StardewValley.dll;$(MonoAndroidIntermediateAssemblyDir)StardewValley.GameData.dll;$(MonoAndroidIntermediateAssemblyDir)BmFont.dll;$(MonoAndroidIntermediateAssemblyDir)Lidgren.Network.dll;$(MonoAndroidIntermediateAssemblyDir)xTile.dll" />
    </ItemGroup>
  </Target>
  <Target Name="ValidateGameHostExecutionMode" BeforeTargets="Build">
    <Error Condition="'$(UseInterpreter)' != 'false'"
           Text="JunimoGate App must use the application-local Mono JIT with UseInterpreter=false for GameHost." />
    <Error Condition="'$(AndroidUseInterpreter)' != 'false'"
           Text="JunimoGate App must use the application-local Mono JIT with AndroidUseInterpreter=false for GameHost." />
    <Error Condition="'$(RunAOTCompilation)' != 'false'"
           Text="JunimoGate App must not AOT-compile the dynamically supplied game workspace." />
    <Error Condition="'$(AndroidUseAssemblyStore)' != 'false'"
           Text="JunimoGate App must use AndroidUseAssemblyStore=false so public runtime providers remain independently verifiable in the final APK." />
    <Error Condition="'$(AndroidEnableAssemblyCompression)' != 'false'"
           Text="JunimoGate App must use AndroidEnableAssemblyCompression=false so public managed provider payload hashes are directly verifiable." />
    <Error Condition="'$(Configuration)' == 'Release' and '$(PublishTrimmed)' != 'false'"
           Text="JunimoGate App Release must remain untrimmed while dynamically loaded game assemblies have no complete trimmer dependency descriptor." />
  </Target>
  <Import Project="../../build/JunimoGate.SmapiBundle.targets" />
  <Import Project="../../build/JunimoGate.MonoRuntime.targets" />
</Project>
